# Feed API base URL used by Flutter (dart-define)
FEED_API_BASE_URL=http://localhost:8000

# Required by feed staging API
# IMPORTANT: must be redis:// or rediss:// endpoint (not REST URL)
FEED_REDIS_URL=rediss://<upstash-redis-host>:<port>

# Optional informational vars (not used by transport layer)
UPSTASH_REDIS_REST_URL=https://<your-upstash>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<upstash-rest-token>

# Qdrant
FEED_QDRANT_URL=https://<cluster>.<region>.gcp.cloud.qdrant.io
FEED_QDRANT_API_KEY=<qdrant-api-key>
FEED_QDRANT_COLLECTION=hundred

# Flutter canary controls
FEED_STABLE_EXPERIMENT_ID=feed-stable-v1
FEED_CANARY_EXPERIMENT_ID=feed-canary-v1
FEED_CANARY_RATIO=0.10
