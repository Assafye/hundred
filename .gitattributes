# Normalize text files and prevent cross-OS line-ending churn
* text=auto

# Keep source files LF across macOS/Windows
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.swift text eol=lf
*.m text eol=lf
*.h text eol=lf
*.cc text eol=lf
*.cmake text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Assets/binaries
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.mp4 binary
*.mov binary
*.pdf binary
*.keystore binary
*.p12 binary
*.cer binary
